<odoo>
  <record id="view_form_student" model="ir.ui.view">
    <field name="name">school.student.form</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <form string="Talaba">
        <sheet>
          <group>
            <field name="name"/>
            <field name="age"/>
            <field name="phone_number"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_tree_student" model="ir.ui.view">
    <field name="name">school.student.tree</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <list string="Talabalar">
        <field name="name"/>
        <field name="age"/>
        <field name="phone_number"/>
      </list>
    </field>
  </record>

  <record id="view_student_tree" model="ir.ui.view">
    <field name="name">school.student.tree</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="age"/>
        <field name="phone_number"/>
      </list>
    </field>
  </record>

  <record id="view_student_form" model="ir.ui.view">
    <field name="name">school.student.form</field>
    <field name="model">school.student</field>
    <field name="arch" type="xml">
      <form string="Student">
        <sheet>
          <notebook>
            <page string="General Information">
              <group>
                <field name="name"/>
                <field name="age"/>
              </group>
            </page>
            <page string="">
              <group>
                <field name="phone_number"/>
                <field name="bio"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_school_student" model="ir.actions.act_window">
    <field name="name">Talabalar</field>
    <field name="res_model">school.student</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        <list editable="top">
          <field name="name"/>
          <field name="age"/>
        </list>
      </p>
    </field>
  </record>

  <menuitem id="menu_school_root"
            name="School Management"/>

  <menuitem id="menu_school_student"
            name="Talabalar"
            parent="menu_school_root"
            action="action_school_student"/>
</odoo>




