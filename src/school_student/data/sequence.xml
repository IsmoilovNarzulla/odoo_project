<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Talaba uchun sequence -->
        <record id="seq_school_student" model="ir.sequence">
            <field name="name">Talaba ID ketma-ketligi</field>
            <field name="code">school.student</field>
            <field name="prefix">STU/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- O'qituvchi uchun sequence -->
        <record id="seq_school_teacher" model="ir.sequence">
            <field name="name">O'qituvchi ID ketma-ketligi</field>
            <field name="code">school.teacher</field>
            <field name="prefix">TCH/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>