<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="productpriceupdate_wizard.list">
      <field name="name">productpriceupdate_wizard list</field>
      <field name="model">productpriceupdate_wizard.productpriceupdate_wizard</field>
      <field name="arch" type="xml">
        <form string="Mahsulot Narxlarini Yangilash">
          <sheet>
            <group>
              <group>
                <field name="percentage"/>
                <field name="category_id"/>
              </group>
            </group>
          </sheet>
          <footer>
            <button name="action_update_prices"
                    string="Yangilash"
                    type="object"
                    class="btn-primary"/>
            <button string="Bekor qilish"
                    special="cancel"
                    class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>


    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="productpriceupdate_wizard.action_window">
      <field name="name">Narxlarni Yangilash</field>
      <field name="res_model">productpriceupdate_wizard.productpriceupdate_wizard</field>
      <field name="view_mode">list,form</field>
      <field name="context">{'default_percentage': 5.0}</field>
    </record>


    <!-- server action to the one above -->

    <record model="ir.actions.server" id="productpriceupdate_wizard.action_server">
      <field name="name">productpriceupdate_wizard server</field>
      <field name="model_id" ref="model_productpriceupdate_wizard_productpriceupdate_wizard"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>


    <!-- Top menu item -->

    <menuitem name="productpriceupdate_wizard" id="productpriceupdate_wizard.menu_root"/>

    <!-- menu categories -->

    <menuitem name="Menu 1" id="productpriceupdate_wizard.menu_1" parent="productpriceupdate_wizard.menu_root"/>
    <menuitem name="Menu 2" id="productpriceupdate_wizard.menu_2" parent="productpriceupdate_wizard.menu_root"/>

    <!-- actions -->

    <menuitem name="List" id="productpriceupdate_wizard.menu_1_list" parent="productpriceupdate_wizard.menu_1"
              action="productpriceupdate_wizard.action_window"/>
    <menuitem name="Server to list" id="productpriceupdate_wizard" parent="productpriceupdate_wizard.menu_2"
              action="productpriceupdate_wizard.action_server"/>

  </data>
</odoo>
