<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- list view -->
    <record id="view_custom_product_list" model="ir.ui.view">
      <field name="name">custom_products.list</field>
      <field name="model">custom_products</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="amount"/>
          <field name="state"/>
        </list>
      </field>
    </record>

    <!-- Form view -->
    <record id="view_custom_product_form" model="ir.ui.view">
      <field name="name">custom_products.form</field>
      <field name="model">custom_products</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="amount"/>
              <field name="state"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Action va menu -->
    <record id="action_custom_product" model="ir.actions.act_window">
      <field name="name">Custom Products</field>
      <field name="res_model">custom_products</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_custom_product_main"
              name="Custom Products"
              sequence="10"/>
    <menuitem id="menu_custom_product"
              name="Products"
              parent="menu_custom_product_main"
              action="action_custom_product"
              sequence="10"/>
  </data>
</odoo>