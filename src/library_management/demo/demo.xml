<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Categories -->
        <record id="category_fiction" model="library.category">
            <field name="name">Fiction</field>
            <field name="code">FIC</field>
        </record>

        <record id="category_science" model="library.category">
            <field name="name">Science</field>
            <field name="code">SCI</field>
        </record>

        <record id="category_history" model="library.category">
            <field name="name">History</field>
            <field name="code">HIS</field>
        </record>

        <!-- Authors -->
        <record id="author_tolkien" model="library.author">
            <field name="name">J.R.R. Tolkien</field>
            <field name="nationality">British</field>
        </record>

        <record id="author_rowling" model="library.author">
            <field name="name">J.K. Rowling</field>
            <field name="nationality">British</field>
        </record>

        <!-- Books -->
        <record id="book_lotr" model="library.book">
            <field name="name">The Lord of the Rings</field>
            <field name="isbn">9780544003415</field>
            <field name="author_id" ref="author_tolkien"/>
            <field name="category_id" ref="category_fiction"/>
            <field name="quantity">5</field>
            <field name="price">45000</field>
            <field name="cost_price">35000</field>
        </record>

        <record id="book_hp" model="library.book">
            <field name="name">Harry Potter and the Philosopher's Stone</field>
            <field name="isbn">9780747532743</field>
            <field name="author_id" ref="author_rowling"/>
            <field name="category_id" ref="category_fiction"/>
            <field name="quantity">3</field>
            <field name="price">35000</field>
            <field name="cost_price">25000</field>
        </record>

        <!-- Members -->
        <record id="member_john" model="library.member">
            <field name="first_name">John</field>
            <field name="last_name">Doe</field>
            <field name="email">john@example.com</field>
            <field name="phone">+998901234567</field>
            <field name="membership_type">student</field>
        </record>

        <!-- Borrowing Records -->
        <record id="borrow_1" model="library.borrow">
            <field name="book_id" ref="book_lotr"/>
            <field name="member_id" ref="member_john"/>
            <field name="borrow_date">2024-01-01</field>
            <field name="due_date">2024-01-15</field>
            <field name="state">returned</field>
        </record>


        <!-- Library Rules -->
        <record id="rule_borrowing" model="library.rules">
            <field name="name">Standard Borrowing Rules</field>
            <field name="rule_type">borrow_limit</field>
            <field name="max_books_per_member">3</field>
            <field name="borrow_duration_days">14</field>
            <field name="max_renewals">2</field>
            <field name="active">True</field>
            <field name="description">Standard rules for book borrowing</field>
        </record>

        <record id="rule_fines" model="library.rules">
            <field name="name">Fine Calculation Rules</field>
            <field name="rule_type">fine_calculation</field>
            <field name="fine_per_day">1000.0</field>
            <field name="grace_period_days">3</field>
            <field name="max_fine_amount">50000.0</field>
            <field name="active">True</field>
            <field name="description">Rules for late return fines</field>
        </record>

        <record id="rule_membership" model="library.rules">
            <field name="name">Membership Rules</field>
            <field name="rule_type">membership</field>
            <field name="student_membership_fee">50000.0</field>
            <field name="teacher_membership_fee">75000.0</field>
            <field name="regular_membership_fee">100000.0</field>
            <field name="premium_membership_fee">150000.0</field>
            <field name="membership_duration_months">12</field>
            <field name="active">True</field>
            <field name="description">Membership fees and durations</field>
        </record>

    </data>
</odoo>