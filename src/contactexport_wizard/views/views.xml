<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Wizard form view -->
    <record id="view_contactexport_wizard_form" model="ir.ui.view">
      <field name="name">contactexport.wizard.form</field>
      <field name="model">contactexport_wizard.contactexport_wizard</field>
      <field name="arch" type="xml">
        <form string="Kontaktlarni eksport qilish">
          <sheet>
            <div class="oe_title">
              <h1>Kontaktlarni eksport qilish</h1>
            </div>
            <group>
              <group>
                <field name="export_format"/>
                <separator string="Eksport qilish uchun maydonlar"/>
                <field name="include_phone"/>
                <field name="include_email"/>
                <field name="include_address"/>
              </group>
              <group>
                <field name="export_result" widget="html"/>
                <field name="filename" invisible="1"/>
                <field name="export_file" filename="filename" invisible="1"/>
              </group>
            </group>
          </sheet>
          <footer>
            <button name="action_export" string="Eksport qilish" type="object" class="btn-primary"/>
            <button string="Bekor qilish" special="cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- Action to open wizard from contacts -->
    <record id="action_contact_export_wizard" model="ir.actions.act_window">
      <field name="name">Kontaktlarni eksport qilish</field>
      <field name="res_model">contactexport_wizard.contactexport_wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="binding_view_types">list,form</field>
      <field name="context">{'default_export_format': 'csv'}</field>
    </record>

    <!-- Action menu item in contacts -->
    <record id="ir_action_contact_export" model="ir.actions.server">
      <field name="name">Eksport qilish</field>
      <field name="binding_view_types">list,form</field>
      <field name="model_id" ref="model_contactexport_wizard_contactexport_wizard"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          'type': 'ir.actions.act_window',
          'name': 'Kontaktlarni eksport qilish',
          'res_model': 'contactexport_wizard.contactexport_wizard',
          'view_mode': 'form',
          'target': 'new',
          'context': {'default_export_format': 'csv'}
        }
      </field>
    </record>
  </data>
</odoo>