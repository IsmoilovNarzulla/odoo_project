<odoo>
  <data>
    <record model="ir.ui.view" id="school_teacher.list">
      <field name="name">school_teacher list</field>
      <field name="model">school_teacher.school_teacher</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="value"/>
          <field name="value2"/>
        </list>
      </field>
    </record>

    <record model="ir.actions.act_window" id="school_teacher.action_window">
      <field name="name">school_teacher window</field>
      <field name="res_model">school_teacher.school_teacher</field>
      <field name="view_mode">list,form</field>
    </record>

    <record model="ir.actions.server" id="school_teacher.action_server">
      <field name="name">school_teacher server</field>
      <field name="model_id" ref="model_school_teacher_school_teacher"/>
      <field name="state">code</field>
      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "list,form",
          "res_model": model._name,
        }
      </field>
    </record>

    <menuitem name="school_teacher" id="school_teacher.menu_root"/>

    <menuitem name="Menu 1" id="school_teacher.menu_1" parent="school_teacher.menu_root"/>
    <menuitem name="Menu 2" id="school_teacher.menu_2" parent="school_teacher.menu_root"/>

    <menuitem name="List" id="school_teacher.menu_1_list" parent="school_teacher.menu_1"
              action="school_teacher.action_window"/>
    <menuitem name="Server to list" id="school_teacher" parent="school_teacher.menu_2"
              action="school_teacher.action_server"/>
  </data>
</odoo>
