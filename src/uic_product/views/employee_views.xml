<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uic_employee_list" model="ir.ui.view">
        <field name="name">uic.employee.list</field>
        <field name="model">uic.employee</field>
        <field name="arch" type="xml">
            <list string="Xodimlar">
                <field name="employee_id" string="Xodim ID"/>
                <field name="department" string="Bo'lim"/>
                <field name="salary" string="Maosh"/>
                <field name="hire_date" string="Ishga kirgan sana" widget="date"/>
            </list>
        </field>
    </record>

    <record id="view_uic_employee_form" model="ir.ui.view">
        <field name="name">uic.employee.form</field>
        <field name="model">uic.employee</field>
        <field name="arch" type="xml">
            <form string="Xodim">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="employee_id"/></h2>
                    </div>

                    <notebook>
                        <page string="Asosiy ma'lumotlar">
                            <group>
                                <group string="Xodim ma'lumotlari">
                                    <field name="employee_id" string="Xodim ID" required="1"/>
                                    <field name="department" string="Bo'lim" widget="radio" options="{'horizontal': true}"/>
                                    <field name="salary" string="Oylik maosh"/>
                                    <field name="hire_date" string="Ishga kirgan sana" widget="date"/>
                                </group>


                                <group string="Shaxsiy ma'lumotlar" invisible="not person_id">
                                    <field name="person_id" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Aloqa ma'lumotlari" invisible="not person_id">
                            <group>
                                <group>
                                </group>
                            </group>
                        </page>

                        <page string="Qo'shimcha ma'lumotlar">
                            <group>
                                <group string="Statistika">
                                    <field name="create_date" string="Yaratilgan sana" readonly="1"/>
                                    <field name="write_date" string="O'zgartirilgan sana" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uic_employee_search" model="ir.ui.view">
        <field name="name">uic.employee.search</field>
        <field name="model">uic.employee</field>
        <field name="arch" type="xml">
            <search string="Xodim qidirish">
                <field name="employee_id" string="Xodim ID"/>
                <!--<field name="name" string="Ism"/>-->
                <field name="department" string="Bo'lim"/>

                <separator/>
                <filter name="filter_sales" string="Sotuv bo'limi"
                        domain="[('department', '=', 'sales')]"/>
                <filter name="filter_purchase" string="Xarid bo'limi"
                        domain="[('department', '=', 'purchase')]"/>
                <filter name="filter_accounting" string="Buxgalteriya"
                        domain="[('department', '=', 'accounting')]"/>
                <filter name="filter_warehouse" string="Ombor"
                        domain="[('department', '=', 'warehouse')]"/>
                <filter name="filter_management" string="Rahbariyat"
                        domain="[('department', '=', 'management')]"/>

                <separator/>

                <filter name="filter_high_salary" string="Yuqori maosh"
                        domain="[('salary', '&gt;', 5000)]"/>
                <filter name="filter_low_salary" string="Past maosh"
                        domain="[('salary', '&lt;', 1000)]"/>

                <separator/>

                <group expand="0" string="Guruhlash">
                    <filter name="group_department" string="Bo'lim bo'yicha"
                            context="{'group_by': 'department'}"/>
                    <filter name="group_salary" string="Maosh bo'yicha"
                            context="{'group_by': 'salary'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_uic_employee" model="ir.actions.act_window">
        <field name="name">Xodimlar</field>
        <field name="res_model">uic.employee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uic_employee_search"/>
        <field name="context">{'search_default_filter_sales': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Hali xodim qo'shilmagan
            </p>
            <p>
                Yangi xodim qo'shish uchun "Yaratish" tugmasini bosing.
            </p>
        </field>
    </record>


    <menuitem id="menu_uic_hr_root" name="Kadrlar boshqaruvi" sequence="30"/>
    <menuitem id="menu_uic_employee" name="Xodimlar"
              parent="menu_uic_hr_root"
              action="action_uic_employee"
              sequence="1"/>
</odoo>