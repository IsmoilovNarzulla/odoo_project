<odoo>
    <data>
        <record id="view_uic_person_list" model="ir.ui.view">
            <field name="name">uic.person.list</field>
            <field name="model">uic.person</field>
            <field name="arch" type="xml">
                <list string="Shaxslar">
                    <field name="name"/>
                    <field name="birth_date" widget="date"/>
                    <field name="gender" widget="selection"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="passport"/>
                    <field name="tin"/>
                </list>
            </field>
        </record>

        <record id="view_uic_person_form" model="ir.ui.view">
            <field name="name">uic.person.form</field>
            <field name="model">uic.person</field>
            <field name="arch" type="xml">
                <form string="Shaxs">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="To'liq ism"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Shaxsiy ma'lumotlar">
                                <field name="birth_date" widget="date"/>
                                <field name="gender" widget="radio"/>
                            </group>

                            <group string="Hujjatlar">
                                <field name="passport"/>
                                <field name="tin"/>
                            </group>
                        </group>

                        <group>
                            <group string="Aloqa ma'lumotlari">
                                <field name="phone" widget="phone"/>
                                <field name="email" widget="email"/>
                                <field name="address"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_uic_person_search" model="ir.ui.view">
            <field name="name">uic.person.search</field>
            <field name="model">uic.person</field>
            <field name="arch" type="xml">
                <search string="Shaxs qidirish">
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="passport"/>
                    <field name="tin"/>
                </search>
            </field>
        </record>

        <record id="action_uic_person" model="ir.actions.act_window">
            <field name="name">Shaxslar</field>
            <field name="res_model">uic.person</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_uic_person" name="Shaxslar" action="action_uic_person"/>

    </data>
</odoo>