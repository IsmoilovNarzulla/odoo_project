<odoo>
    <data>
        <record id="view_uic_partner_list" model="ir.ui.view">
            <field name="name">uic.partner.list</field>
            <field name="model">uic.partner</field>
            <field name="arch" type="xml">
                <list string="Hamkorlar" decoration-success="partner_type == 'customer'" decoration-info="partner_type == 'supplier'" decoration-warning="partner_type == 'both'">
                    <field name="name"/>
                    <field name="partner_type" widget="selection"/>
                    <field name="company_name"/>
                    <field name="vat"/>
                    <field name="credit_limit"/>
                    <field name="payment_term"/>
                    <field name="phone"/>
                    <field name="email"/>
                </list>
            </field>
        </record>

        <record id="view_uic_partner_form" model="ir.ui.view">
            <field name="name">uic.partner.form</field>
            <field name="model">uic.partner</field>
            <field name="arch" type="xml">
                <form string="Hamkor">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Hamkor nomi"/>
                            </h1>
                            <h2>
                                <field name="company_name" placeholder="Kompaniya nomi"/>
                            </h2>
                        </div>

                        <group>
                            <group string="Hamkor ma'lumotlari">
                                <field name="partner_type" widget="radio" options="{'horizontal': true}" required="1"/>
                                <field name="company_name"/>
                                <field name="vat"/>
                                <field name="credit_limit"/>
                                <field name="payment_term"/>
                            </group>

                            <group string="Aloqa ma'lumotlari">
                                <field name="phone" widget="phone"/>
                                <field name="email" widget="email"/>
                                <field name="address"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_uic_partner_search" model="ir.ui.view">
            <field name="name">uic.partner.search</field>
            <field name="model">uic.partner</field>
            <field name="arch" type="xml">
                <search string="Hamkor qidirish">
                    <field name="name"/>
                    <field name="company_name"/>
                    <field name="vat"/>
                    <field name="phone"/>
                    <field name="email"/>

                    <separator/>

                    <filter name="customer" string="Mijozlar" domain="[('partner_type', '=', 'customer')]"/>
                    <filter name="supplier" string="Ta'minotchilar" domain="[('partner_type', '=', 'supplier')]"/>
                    <filter name="both" string="Ikkalasi ham" domain="[('partner_type', '=', 'both')]"/>

                    <separator/>

                    <filter name="has_credit" string="Kredit limiti bor" domain="[('credit_limit', '>', 0)]"/>
                    <filter name="no_credit" string="Kredit limiti yo'q" domain="[('credit_limit', '=', 0)]"/>
                </search>
            </field>
        </record>
        <record id="action_uic_partner" model="ir.actions.act_window">
            <field name="name">Hamkorlar</field>
            <field name="res_model">uic.partner</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_uic_partner" name="Hamkorlar" action="action_uic_partner"/>

    </data>
</odoo>