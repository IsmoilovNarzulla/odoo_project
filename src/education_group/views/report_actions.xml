<odoo>
    <!-- Report Action -->
    <record id="action_group_report_pdf" model="ir.actions.report">
        <field name="name">Guruh hisoboti (PDF)</field>
        <field name="model">education_group.education_group</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">education_group.report_group_document</field>
        <field name="report_file">education_center.report_group_document</field>
        <field name="print_report_name">'Guruh_Hisoboti_%s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_education_group_education_group"/>
        <field name="binding_type">report</field>
        <field name="multi">False</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Print Menyu uchun action -->
    <record id="action_group_report_print" model="ir.actions.act_window">
        <field name="name">Print Guruh</field>
        <field name="res_model">education_group.education_group</field>
        <field name="view_mode">form</field>
    </record>
</odoo>