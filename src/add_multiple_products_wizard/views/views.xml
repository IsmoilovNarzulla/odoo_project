<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Wizard form view -->
    <record model="ir.ui.view" id="add_multiple_products_wizard_form_view">
      <field name="name">add.multiple.products.wizard.form</field>
      <field name="model">add_multiple_products_wizard.add_multiple_products_wizard</field>
      <field name="arch" type="xml">
        <form string="Mahsulot Qo'shish">
          <sheet>
            <div class="oe_title">
              <h1>Mahsulot Qo'shish</h1>
            </div>
            <group>
              <field name="order_id" invisible="1"/>
              <field name="product_lines">
                <tree editable="bottom" string="Mahsulotlar">
                  <field name="product_id" widget="many2one" options="{'no_create': True}"/>
                  <field name="quantity"/>
                  <field name="price_unit"/>
                </tree>
              </field>
            </group>
          </sheet>
          <footer>
            <button name="action_add_products"
                    string="Qo'shish"
                    type="object"
                    class="btn-primary"/>
            <button string="Bekor qilish"
                    special="cancel"
                    class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- Action to open wizard -->
    <record model="ir.actions.act_window" id="action_add_multiple_products_wizard">
      <field name="name">Mahsulot Qo'shish</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">add_multiple_products_wizard.add_multiple_products_wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="binding_model_id" ref="sale.model_sale_order"/>
      <field name="binding_view_types">form</field>
    </record>

    <!-- Context menu action for sale order form -->
    <record id="sale_order_action_add_multiple_products" model="ir.actions.server">
      <field name="name">Bir nechta mahsulot qo'shish</field>
      <field name="model_id" ref="sale.model_sale_order"/>
      <field name="binding_model_id" ref="sale.model_sale_order"/>
      <field name="binding_view_types">form</field>
      <field name="state">code</field>
    </record>

    <!-- Context menu item -->
    <menuitem id="menu_sale_order_add_multiple_products"
              name="Bir nechta mahsulot qo'shish"
              parent="sale.sale_order_menu"
              action="sale_order_action_add_multiple_products"
              sequence="10"/>
  </data>
</odoo>